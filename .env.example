# Копирай този файл като .env и попълни реалните стойности.
#   cp .env.example .env
# .env НЕ влиза в git.

# ---- Django ----
# Генериране на нов ключ:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET_KEY=

# Само за prod. В dev има default в config/settings/dev.py.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Разкоментирай, за да видиш всяка SQL заявка в конзолата (само dev).
# DJANGO_SQL_LOG_LEVEL=DEBUG

# ---- MySQL ----
DB_NAME=irida
DB_USER=gimas
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=3306

# ---- Само prod ----
# DJANGO_CSRF_TRUSTED_ORIGINS=https://example.bg
# DJANGO_SECURE_SSL_REDIRECT=True
